{
  "manifest_version": 3,
  "name": "UnderSec - Real-Time XGBoost Chrome Phishing Extension",
  "version": "4.0.0",
  "description": "Real-time client security evaluating 7 URL heuristic features via trained XGBoost ML inference & Ollama GenAI reasoning.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon16.png",
    "default_title": "UnderSec Phishing Guard"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "<all_urls>"
  ]
}